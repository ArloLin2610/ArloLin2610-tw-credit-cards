# Needed only for the automated checker's LLM extraction (scripts/check-updates.mjs).
# Without it the checker still detects page changes and opens a review PR, but
# does not draft data edits.
ANTHROPIC_API_KEY=
# Optional: override the model used for extraction.
LLM_MODEL=claude-sonnet-5-5
# Optional: canonical site URL for sitemap / OG tags (Netlify sets URL automatically).
SITE_URL=
