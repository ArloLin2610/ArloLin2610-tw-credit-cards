---
import Base from '../../layouts/Base.astro';
import CardExplorer from '../../components/CardExplorer.tsx';
import { banks, summaries } from '../../lib/data';
import { REWARD_TYPE_DESC, REWARD_TYPE_LABEL, type RewardType } from '../../lib/types';

export function getStaticPaths() {
  return (['cashback', 'miles', 'points', 'other'] as RewardType[]).map((type) => ({ params: { type } }));
}

const type = Astro.params.type as RewardType;
const list = summaries.filter((c) => c.rewardType === type);
const bankOpts = banks.map((b) => ({ id: b.id, short_name: b.short_name }));
const title = `${REWARD_TYPE_LABEL[type]}信用卡比較`;
---

<Base title={title} description={`台灣 ${list.filter((c) => c.status === 'active').length} 張${REWARD_TYPE_LABEL[type]}信用卡一次比較：${REWARD_TYPE_DESC[type]}`}>
  <section class="mx-auto max-w-6xl px-4 pb-6 pt-10">
    <h1 class="text-3xl font-black tracking-tight md:text-4xl">{title}</h1>
    <p class="mt-3 max-w-prose text-ink-soft">{REWARD_TYPE_DESC[type]}</p>
    {type === 'miles' && (
      <p class="mt-2 max-w-prose text-sm text-ink-soft">哩程卡的「回饋率」以每累積一哩需要的消費金額表示，數字越小越好。</p>
    )}
  </section>
  <section class="mx-auto max-w-6xl px-4 pb-24">
    <CardExplorer client:load cards={list} banks={bankOpts} fixedType={type} />
  </section>
</Base>
