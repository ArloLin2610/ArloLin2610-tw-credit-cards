---
import Base from '../layouts/Base.astro';
---

<Base title="找不到頁面" noindex>
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <h1 class="text-3xl font-black tracking-tight">找不到這張卡</h1>
    <p class="mt-3 text-ink-soft">這張卡可能已經下架，或網址有誤。</p>
    <a href="/" class="btn btn-primary mt-6">回首頁找卡</a>
  </section>
</Base>
