---
import Base from '../../layouts/Base.astro';
import CardExplorer from '../../components/CardExplorer.tsx';
import { banks, summaries } from '../../lib/data';

export function getStaticPaths() {
  return banks.map((bank) => ({ params: { id: bank.id }, props: { bank } }));
}

const { bank } = Astro.props;
const list = summaries.filter((c) => c.bank === bank.id);
const active = list.filter((c) => c.status === 'active').length;
---

<Base title={`${bank.short_name}信用卡總覽`} description={`${bank.name}目前 ${active} 張可申請的信用卡，回饋率、年費與卡圖一次比較。`}>
  <section class="mx-auto max-w-6xl px-4 pb-6 pt-10">
    <div class="flex items-center gap-4">
      <span class="inline-block h-12 w-12 shrink-0 rounded-xl" style={`background:${bank.color}`} aria-hidden="true"></span>
      <div>
        <h1 class="text-3xl font-black tracking-tight md:text-4xl">{bank.short_name}信用卡</h1>
        <p class="text-sm text-ink-soft">{bank.name}{bank.name_en ? `・${bank.name_en}` : ''}</p>
      </div>
    </div>
    {bank.notes && (
      <div class="mt-4 rounded-xl border border-danger/30 bg-danger-soft px-4 py-3 text-sm text-danger">{bank.notes}</div>
    )}
    <p class="mt-4 text-sm text-ink-soft">
      官方卡片總覽：<a href={bank.cards_index_url} target="_blank" rel="noopener nofollow" class="underline">{new URL(bank.cards_index_url).hostname}</a>
    </p>
  </section>
  <section class="mx-auto max-w-6xl px-4 pb-24">
    <CardExplorer client:load cards={list} banks={[{ id: bank.id, short_name: bank.short_name }]} fixedBank={bank.id} />
  </section>
</Base>
