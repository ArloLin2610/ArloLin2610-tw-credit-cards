---
import type { Card } from '../lib/types';
import { REWARD_TYPE_LABEL, TAG_LABEL, STATUS_LABEL } from '../lib/types';
import { bankById, bestReward, cardImage, formatFee } from '../lib/data';

interface Props {
  card: Card;
  showBank?: boolean;
}
const { card, showBank = true } = Astro.props;
const bank = bankById.get(card.bank);
const img = cardImage(card);
const best = bestReward(card);
const rewardClass = `reward-${card.reward_type === 'cashback' ? 'cash' : card.reward_type}`;
const inactive = card.status !== 'active';
---

<a href={`/cards/${card.id}`} class:list={['tile block p-3', { 'opacity-70': inactive }]}>
  <div class="card-face">
    <img src={img.src} alt={`${bank?.short_name ?? ''} ${card.name} 卡面`} loading="lazy" decoding="async" width="320" height="202" />
    {inactive && (
      <span class="absolute left-2 top-2 rounded-md bg-danger-soft px-2 py-0.5 text-xs font-semibold text-danger">{STATUS_LABEL[card.status]}</span>
    )}
  </div>
  <div class="mt-3 flex items-start justify-between gap-2">
    <div class="min-w-0">
      {showBank && <div class="text-xs text-ink-soft">{bank?.short_name}</div>}
      <h3 class="truncate text-base font-bold leading-snug">{card.name}</h3>
    </div>
    <span class:list={['shrink-0 rounded-md px-2 py-0.5 text-xs font-semibold', rewardClass]}>{REWARD_TYPE_LABEL[card.reward_type]}</span>
  </div>
  <p class="mt-1 line-clamp-2 text-sm text-ink-soft">{card.headline}</p>
  <div class="mt-3 flex items-baseline justify-between">
    <span class="text-2xl font-black tracking-tight">{best?.rate}</span>
    <span class="text-xs text-ink-soft">{formatFee(card)}</span>
  </div>
  {card.tags.length > 0 && (
    <div class="mt-2 flex flex-wrap gap-1">
      {card.tags.slice(0, 4).map((t) => (
        <span class="rounded bg-paper-2 px-1.5 py-0.5 text-[11px] text-ink-soft">{TAG_LABEL[t]}</span>
      ))}
    </div>
  )}
</a>
